# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=skillforge
DATABASE_PASSWORD=secure-password
DATABASE_NAME=skillforge

# JWT Configuration
JWT_SECRET=very-secret-key
JWT_EXPIRES_IN=7d

# Application Configuration. PORT must be 3000 for Docker
PORT=6567
NODE_ENV=production
APP_BASE_URL=http://localhost:6567

# S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=access-key-id
AWS_SECRET_ACCESS_KEY=secret-access-key
AWS_S3_BUCKET=skillforge
# Optional: Custom S3-compatible endpoint
# AWS_S3_ENDPOINT=http://localhost:9000           # MinIO
# AWS_S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com  # Cloudflare R2

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Piston Configuration
PISTON_BASE_URL=http://localhost:2000
